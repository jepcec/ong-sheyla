---
import Layout from '../layouts/Layout.astro'; import SiteHeader from '../components/SiteHeader.astro'; import SiteFooter from '../components/SiteFooter.astro'; import ProgramCard from '../components/ProgramCard.astro'; import StatusCard from '../components/StatusCard.astro'; import '../styles/global.css';
const programs=[['01','Mujeres emprendedoras','Acompañamiento a mujeres artesanas y productoras, con espacios para compartir y vender sus prendas y tejidos.','/programas/mujeres-emprendedoras/'],['02','Educación y formación','Talleres y campañas que acercan herramientas de aprendizaje a mujeres, familias y comunidades.','/programas/educacion-formacion/'],['03','Identidad cultural','Saberes, vestimenta, tejidos y tradiciones como parte viva del desarrollo de cada comunidad.','/programas/identidad-cultural/'],['04','Liderazgo y empoderamiento','Redes y espacios para que más mujeres tomen decisiones y lideren sus propios procesos.','/programas/liderazgo-empoderamiento/'],['05','Familia','Actividades comunitarias que fortalecen el cuidado, el respeto y el desarrollo compartido.','/programas/familia/']]; const pending=[['—','Mujeres acompañadas'],['—','Proyectos activos'],['—','Años de trabajo'],['—','Lugares de trabajo']];
---
<Layout title="Ñañachaykuna | Mujeres emprendedoras en Cusco" description="ONG de Cusco que acompaña a mujeres emprendedoras, valora la identidad cultural y fortalece a las familias y comunidades."><SiteHeader /><main id="contenido">
<section class="hero wrap" data-enter aria-labelledby="hero-title"><div><p class="eyebrow" data-enter-item>ONG Ñañachaykuna · Cusco, Perú</p><h1 id="hero-title" data-enter-item>Tejemos historias, creamos oportunidades.</h1><p class="hero__lead" data-enter-item>Somos una organización que impulsa iniciativas de desarrollo social, acompaña a mujeres artesanas y productoras rurales, y promueve la identidad cultural y el trabajo comunitario.</p><div class="hero__actions" data-enter-item><a class="btn" href="https://docs.google.com/forms/d/e/1FAIpQLSedaEvMfvuRRDXTBhKtiCx7-TI58vY3zVtGdMuQOZnSVm3kdw/viewform?usp=header" target="_blank" rel="noreferrer">Únete al voluntariado <span aria-hidden="true">↗</span></a><a class="text-link" href="#programas">Ver programas <span aria-hidden="true">↘</span></a></div><p class="hero__fact" data-enter-item>Trabajo con mujeres y comunidades de Cusco</p></div><div class="hero__media" data-enter-item><!-- Slot de cliente: Foto 3. Stand-in temporal. --><img src="/standins/community-01.jpg" alt="Fotografía stand-in de una actividad comunitaria al aire libre" width="2400" height="1611" fetchpriority="high" /></div></section>
<section class="section section--soft" aria-labelledby="ejes-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Lo que guía el trabajo</p><h2 id="ejes-title">Cuatro ejes, una tarea compartida.</h2></div><p>La organización trabaja desde las capacidades de las mujeres y los saberes de sus comunidades.</p></div><div class="pillar-grid"><article class="pillar"><h3>Identidad cultural</h3><p>Tradiciones, lengua y saberes que sostienen cada emprendimiento.</p></article><article class="pillar"><h3>Empoderamiento femenino</h3><p>Más decisiones, liderazgo y autonomía personal y económica.</p></article><article class="pillar"><h3>Fortalecimiento de la familia</h3><p>La familia como espacio de cuidado, respeto y desarrollo compartido.</p></article><article class="pillar"><h3>Mujeres emprendedoras</h3><p>Capacidades y oportunidades para crear, crecer y comercializar.</p></article></div></div></section>
<section class="section" aria-labelledby="proposito-title"><div class="wrap purpose"><div><p class="eyebrow">Propósito</p><h2 id="proposito-title" class="purpose__statement">Tejemos oportunidades con las mujeres del Cusco.</h2></div><p class="purpose__aside">Acompañamos sus capacidades, valoramos sus saberes y fortalecemos la identidad cultural y la unión de sus familias y comunidades.</p></div></section>
<section class="section section--soft" id="programas" aria-labelledby="programas-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Programas</p><h2 id="programas-title">Líneas de acción.</h2></div><p>Conoce los caminos que conectan formación, identidad cultural, emprendimiento y comunidad.</p></div><div class="program-grid">{programs.map(([number,title,text,href])=><a class="program-card" href={href}><span class="program-card__number">{number}</span><div><h3>{title}</h3><p>{text}</p></div><span class="program-card__arrow" aria-hidden="true">Ver programa <span>↗</span></span></a>)}</div></div></section>
<section class="section section--deep" aria-labelledby="impacto-title"><div class="wrap impact"><div><p class="eyebrow" style="color:var(--ochre)">Impacto</p><h2 id="impacto-title">Las cifras también cuentan una historia.</h2><p class="impact__note">La ONG está consolidando sus cifras oficiales para publicarlas con contexto y responsabilidad.</p></div><div class="status-grid">{pending.map(([number,label])=><article class="status-card" data-pending><strong>{number}</strong><span>{label}</span></article>)}</div></div></section>
<section class="section" aria-labelledby="marcha-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">En marcha</p><h2 id="marcha-title">Iniciativas que ya están caminando.</h2></div><p>Proyectos y campañas que reúnen a mujeres, voluntariado, familias y aliados.</p></div><div class="initiative-grid"><article class="initiative"><h3>Simi Kallpa</h3><p>Trabajo con mujeres artesanas para valorar sus saberes y fortalecer sus capacidades.</p></article><article class="initiative"><h3>Yanatile Tikarisun</h3><p>Apoyo solidario y voluntariado ante los incendios forestales en Yanatile.</p></article><article class="initiative"><h3>Un Panetón Futuro</h3><p>Cada panetón comprado se convierte en útiles escolares para niñas y niños de comunidades de Cusco.</p></article><article class="initiative"><h3>Voluntariado</h3><p>Tiempo, conocimientos y habilidades para acompañar el trabajo de la organización.</p></article></div></div></section>
<section class="section section--soft" aria-labelledby="moment-title"><div class="wrap moment"><div><p class="eyebrow">Una forma de trabajar</p><h2 id="moment-title" class="moment__quote">Compartir saberes cambia la escala de una <em>comunidad.</em></h2></div><div class="moment__photo"><!-- Slot de cliente: Foto 2. Stand-in temporal. --><img src="/standins/community-02.jpg" alt="Fotografía stand-in de un grupo reunido en un espacio de trabajo comunitario" width="2400" height="1589" loading="lazy" /></div></div></section>
<section class="section" aria-labelledby="galeria-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Galería</p><h2 id="galeria-title">Personas, saberes y territorio.</h2></div><p>Las fotos de la ONG reemplazarán estos stand-ins cuando se confirme el permiso de uso de imagen.</p></div><div class="gallery"><a href="/quienes-somos/"><img src="/standins/community-03.jpg" alt="Fotografía stand-in de personas trabajando juntas" width="1400" height="933" loading="lazy" /></a><a href="/programas/identidad-cultural/"><img src="/standins/community-04.jpg" alt="Fotografía stand-in de una actividad cultural" width="1280" height="853" loading="lazy" /></a><a href="/programas/mujeres-emprendedoras/"><img src="/standins/community-05.jpg" alt="Fotografía stand-in de una actividad de aprendizaje" width="1800" height="1200" loading="lazy" /></a><a href="/convocatorias/"><img src="/standins/community-06.jpg" alt="Fotografía stand-in de una reunión comunitaria" width="1800" height="1200" loading="lazy" /></a></div></div></section>
<section class="section section--deep"><div class="wrap cta-band"><div><p class="eyebrow" style="color:var(--ochre)">Participa</p><h2>Tu tiempo también puede acompañar una oportunidad.</h2></div><div><p>Únete al voluntariado y cuéntanos qué sabes hacer y por qué quieres sumarte.</p><a class="btn btn--light" href="https://docs.google.com/forms/d/e/1FAIpQLSedaEvMfvuRRDXTBhKtiCx7-TI58vY3zVtGdMuQOZnSVm3kdw/viewform?usp=header" target="_blank" rel="noreferrer">Únete al voluntariado <span aria-hidden="true">↗</span></a></div></div></section>
</main><SiteFooter /></Layout>
