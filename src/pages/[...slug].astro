---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
const volunteerUrl='https://docs.google.com/forms/d/e/1FAIpQLSedaEvMfvuRRDXTBhKtiCx7-TI58vY3zVtGdMuQOZnSVm3kdw/viewform?usp=header';
const programs=[{slug:'mujeres-emprendedoras',title:'Mujeres emprendedoras',intro:'Acompañamos a mujeres artesanas y productoras para fortalecer sus capacidades y sus oportunidades.',body:'El programa reúne acompañamiento, intercambio de saberes y espacios para que las emprendedoras presenten sus prendas y tejidos.'},{slug:'educacion-formacion',title:'Educación y formación',intro:'La formación acerca herramientas que mejoran las oportunidades de las mujeres y sus familias.',body:'Incluye talleres, espacios de aprendizaje y la campaña Un Panetón Futuro, que convierte cada panetón vendido en útiles escolares.'},{slug:'identidad-cultural',title:'Identidad cultural',intro:'Los saberes, la vestimenta, los tejidos y las tradiciones son parte del desarrollo de cada comunidad.',body:'Este eje pone en valor lo que las comunidades ya conocen y practican.'},{slug:'liderazgo-empoderamiento',title:'Liderazgo y empoderamiento',intro:'Creamos espacios para que más mujeres tomen decisiones, lideren y ganen autonomía.',body:'Las redes de mujeres y las escuelas de liderazgo forman parte de esta línea de trabajo.'},{slug:'familia',title:'Familia',intro:'Trabajamos con la familia como espacio de cuidado, respeto y desarrollo compartido.',body:'Las actividades comunitarias fortalecen la conversación, la participación y la solidaridad entre generaciones.'}];
export function getStaticPaths(){const paths=['quienes-somos','lineamientos','programas','convocatorias','transparencia','donaciones','contacto','programas/mujeres-emprendedoras','programas/educacion-formacion','programas/identidad-cultural','programas/liderazgo-empoderamiento','programas/familia','programas/simi-kallpa','programas/un-panetón-futuro'];return paths.map((slug)=>({params:{slug}}));}
const slug=Astro.params.slug||''; const program=programs.find((item)=>slug==='programas/'+item.slug);
const project=slug==='programas/simi-kallpa'?{title:'Simi Kallpa',intro:'Trabajo con mujeres artesanas para valorar sus saberes y fortalecer sus capacidades.',body:'La información de la comunidad beneficiaria, las metas y las etapas se publicará conforme a la ficha oficial vigente del proyecto.',image:'/standins/community-03.jpg'}:slug==='programas/un-panetón-futuro'?{title:'Un Panetón Futuro',intro:'Compra un panetón y siembra un futuro brillante.',body:'Cada panetón comprado se transforma en útiles escolares para niñas y niños de la región de Cusco. El precio, las fechas y los puntos de venta están pendientes de confirmación.',image:'/standins/community-04.jpg'}:null;
const pages={ 'quienes-somos':{title:'Quiénes somos',intro:'Caminamos juntas, tejemos futuro.',body:'Ñañachaykuna trabaja desde Cusco, Perú, a favor de las mujeres emprendedoras, la identidad cultural y el fortalecimiento de la familia.',heading:'Una organización que aprende con las comunidades.'}, 'lineamientos':{title:'Lineamientos',intro:'Principios que guían el trabajo de la ONG.',body:'Estos cinco lineamientos orientan la forma de acompañar a las mujeres, sus familias y sus comunidades.',heading:'Cinco líneas para sostener el trabajo.'}, 'programas':{title:'Programas',intro:'Líneas de acción para acompañar capacidades y oportunidades.',body:'Cada programa conecta un eje del trabajo de Ñañachaykuna con una forma concreta de participar.',heading:'Programas y proyectos.'}, 'convocatorias':{title:'Convocatorias',intro:'Oportunidades para participar con tiempo, conocimientos o habilidades.',body:'La convocatoria de voluntariado está abierta a personas que quieran conocer el trabajo de la ONG y sumarse a sus iniciativas.',heading:'Participar también es acompañar.'}, 'transparencia':{title:'Transparencia',intro:'Información institucional para conocer cómo trabajamos.',body:'La organización está reuniendo los documentos y datos que desea publicar en esta sección.',heading:'Documentos y datos en preparación.'}, 'donaciones':{title:'Donaciones',intro:'Tu apoyo puede acompañar el trabajo con mujeres y comunidades.',body:'Las instrucciones para donar por transferencia bancaria se publicarán cuando la ONG confirme por escrito la cuenta, el CCI y el titular autorizado.',heading:'Apoyar con información confirmada.'}, 'contacto':{title:'Contacto',intro:'Conversemos sobre voluntariado, alianzas y formas de colaborar.',body:'El correo, teléfono, WhatsApp y dirección de la ONG están pendientes de confirmación.',heading:'Escríbenos cuando quieras sumarte.'} };
const page=pages[slug as keyof typeof pages]; const title=project?.title||program?.title||page?.title||'Ñañachaykuna'; const intro=project?.intro||program?.intro||page?.intro||''; const body=project?.body||program?.body||page?.body||'';
---
<Layout title={title + ' | Ñañachaykuna'} description={intro}><SiteHeader /><main id="contenido">
<section class="page-hero"><div class="wrap page-hero__grid"><div><p class="eyebrow" data-enter-item>Ñañachaykuna · Cusco, Perú</p><h1 data-enter-item>{title}</h1></div><p data-enter-item>{intro}</p></div></section>
{slug==='programas'?<section class="section"><div class="wrap"><div class="program-grid">{programs.map((item,index)=><a class="program-card" href={'/programas/'+item.slug+'/' }><span class="program-card__number">0{index+1}</span><div><h3>{item.title}</h3><p>{item.intro}</p></div><span class="program-card__arrow" aria-hidden="true">Ver programa <span>↗</span></span></a>)}</div></div></section>:project?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Proyecto</p><h2>{project.title}</h2><p>{body}</p></div><div class="moment__photo"><img src={project.image} alt="Fotografía stand-in de una actividad comunitaria" width="1400" height="933" /></div></div></section>:slug==='lineamientos'?<section class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">Lineamientos</p><h2>{page?.heading}</h2></div><p>{body}</p></div><div class="rule-list">{[['Educación','Promovemos la formación y la capacitación de las mujeres emprendedoras y de sus familias.'],['Identidad cultural','Valoramos y difundimos las tradiciones, la lengua y los saberes de nuestras comunidades.'],['Empoderamiento femenino','Acompañamos a las mujeres para que tomen decisiones, lideren y ganen autonomía.'],['Fortalecimiento de la familia','Trabajamos con la familia como espacio de cuidado, respeto y desarrollo compartido.'],['Emprendimiento','Apoyamos a las mujeres en la creación, el crecimiento y la comercialización de sus negocios.']].map(([name,text])=><article class="rule-row"><h3>{name}</h3><p>{text}</p></article>)}</div></div></section>:slug==='quienes-somos'?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Nuestra forma de trabajar</p><h2>{page?.heading}</h2><p>{body}</p><p>Promovemos la participación, el aprendizaje colaborativo y la solidaridad, articulando esfuerzos con mujeres, voluntariado, comunidades y aliados.</p></div><div class="notice" data-pending><strong>Historia y equipo pendientes de confirmación</strong><p>El año de fundación, las fundadoras y los nombres de la directiva se incorporarán con la información oficial de la ONG.</p></div></div></section>:slug==='transparencia'?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Transparencia</p><h2>{page?.heading}</h2><p>{body}</p></div><div class="notice" data-pending><strong>Documentos institucionales pendientes</strong><p>La partida registral, el estatuto y la memoria anual se publicarán cuando la ONG decida compartirlos.</p></div></div></section>:slug==='donaciones'?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Donaciones</p><h2>{page?.heading}</h2><p>{body}</p><a class="btn" href="/contacto/">Contacta para donar <span aria-hidden="true">↗</span></a></div><div class="notice" data-pending><strong>Datos bancarios reservados</strong><p>Banco, cuenta, CCI y titular serán visibles después de la confirmación escrita de la organización.</p></div></div></section>:slug==='contacto'?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Contacto</p><h2>{page?.heading}</h2><p>{body}</p><dl class="detail-list"><div><dt>Ciudad y región</dt><dd>Cusco, Perú</dd></div><div><dt>Correo</dt><dd data-pending>Por confirmar</dd></div><div><dt>Redes</dt><dd>Instagram · TikTok · YouTube</dd></div></dl></div><form class="form" action="https://formsubmit.co/contacto@nanachaykuna.example" method="POST"><label>Nombre<input name="name" required /></label><label>Correo electrónico<input type="email" name="email" required /></label><label>Mensaje<textarea name="message" required></textarea></label><button class="btn" type="submit">Enviar mensaje <span aria-hidden="true">↗</span></button></form></div></section>:slug==='convocatorias'?<section class="section"><div class="wrap content-grid"><div><p class="eyebrow">Convocatorias</p><h2>{page?.heading}</h2><p>{body}</p><a class="btn" href={volunteerUrl} target="_blank" rel="noreferrer">Únete al voluntariado <span aria-hidden="true">↗</span></a></div><div class="notice"><strong>Voluntariado</strong><p>Cuéntanos tus datos, tus habilidades y por qué quieres sumarte al trabajo de la ONG.</p></div></div></section>:<section class="section"><div class="wrap"><p>{body}</p></div></section>}
<section class="section section--deep"><div class="wrap cta-band"><div><p class="eyebrow" style="color:var(--ochre)">Participa</p><h2>Tu tiempo puede acompañar una oportunidad.</h2></div><a class="btn btn--light" href={volunteerUrl} target="_blank" rel="noreferrer">Únete al voluntariado <span aria-hidden="true">↗</span></a></div></section>
</main><SiteFooter /></Layout>
