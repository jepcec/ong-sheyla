---
const links=[['Quiénes somos','/quienes-somos/'],['Lineamientos','/lineamientos/'],['Programas','/programas/'],['Convocatorias','/convocatorias/'],['Transparencia','/transparencia/'],['Contacto','/contacto/']];
---
<header class="site-header"><a class="brand" href="/" aria-label="Ñañachaykuna, inicio"><span class="brand-mark" aria-hidden="true">✦</span><span>Ñañachaykuna<small>ONG · Cusco</small></span></a><nav aria-label="Navegación principal">{links.map(([label,href])=><a href={href}>{label}</a>)}<a class="nav-cta" href="/donaciones/">Donar</a></nav><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menú</button></header>
<style>.site-header{position:absolute;z-index:10;top:0;left:0;right:0;width:min(100% - 64px,1240px);margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:28px;padding:26px 0}.brand{display:inline-flex;align-items:center;gap:10px;font-family:'DM Serif Display',serif;font-size:1.45rem;line-height:.85;text-decoration:none;white-space:nowrap}.brand small{display:block;margin-top:8px;font-family:'DM Sans',sans-serif;color:var(--muted);font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:50% 0 50% 0;background:var(--fuchsia);color:white;font-family:'DM Sans',sans-serif;font-size:.9rem;transform:rotate(-20deg)}nav{display:flex;align-items:center;gap:22px;font-size:.83rem;font-weight:600}nav a{text-decoration:none;text-underline-offset:5px}nav a:not(.nav-cta):hover{text-decoration:underline;text-decoration-color:var(--fuchsia)}.nav-cta{padding:11px 15px;background:var(--fuchsia);color:white}.menu-toggle{display:none;border:1px solid var(--line);background:transparent;padding:10px 12px}@media(max-width:1000px){.site-header{width:min(100% - 40px,680px)}nav{display:none}.menu-toggle{display:block}}@media(max-width:560px){.site-header{width:min(100% - 32px,480px)}.brand{font-size:1.25rem}}</style>
<script is:inline>const button=document.querySelector('.menu-toggle');const nav=document.querySelector('.site-header nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')==='true';button.setAttribute('aria-expanded',String(!open));if(nav){nav.style.display=open?'':'grid';nav.style.position='absolute';nav.style.top='80px';nav.style.left='0';nav.style.right='0';nav.style.padding='20px';nav.style.background='var(--white)';nav.style.border='1px solid var(--line)'}});</script>
