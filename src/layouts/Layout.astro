---
interface Props { title: string; description: string; pageType?: string }
const { title, description, pageType = 'service' } = Astro.props;
---
<!doctype html>
<html lang="es" data-type={pageType} data-page-type={pageType} data-site-kind="other" data-radius="square" data-buttons="solid" data-motion>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="page-type" content={pageType} /><meta name="site-kind" content="other" /><meta name="theme-color" content="#f8edf2" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title><script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
  </head>
  <body><a class="skip-link" href="#contenido">Saltar al contenido</a><slot /></body>
</html>
